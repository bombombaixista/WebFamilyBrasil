@model IEnumerable<Kanban.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos Integrados";

    var pedidos = Model?.ToList() ?? new List<Kanban.Models.Pedido>();
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container-fluid">

    <!-- TÍTULO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-box-seam text-primary"></i> Pedidos Integrados
        </h2>
    </div>

    <!-- FILTROS -->
    <form method="get" class="card shadow-sm mb-4">
        <div class="card-body row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Cliente</label>
                <input type="text" name="cliente" class="form-control" placeholder="Buscar cliente" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Origem</label>
                <select name="origem" class="form-select">
                    <option value="">Todas</option>
                    <option>Mercado Livre</option>
                    <option>Shopee</option>
                    <option>AliExpress</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">Todos</option>
                    <option>Pago</option>
                    <option>Enviado</option>
                    <option>Aguardando envio</option>
                    <option>Cancelado</option>
                </select>
            </div>

            <div class="col-md-2 d-grid">
                <button class="btn btn-primary">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>
            </div>
        </div>
    </form>

    <!-- CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow border-0 bg-primary text-white">
                <div class="card-body text-center">
                    <small>Total de Pedidos</small>
                    <h3>@pedidos.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow border-0 bg-success text-white">
                <div class="card-body text-center">
                    <small>Valor Total</small>
                    <h3>@pedidos.Sum(p => p.ValorTotal).ToString("C")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow border-0 bg-warning text-dark">
                <div class="card-body text-center">
                    <small>Pendentes</small>
                    <h3>@pedidos.Count(p => p.Status == "Aguardando envio")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow border-0 bg-danger text-white">
                <div class="card-body text-center">
                    <small>Cancelados</small>
                    <h3>@pedidos.Count(p => p.Status == "Cancelado")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- GRÁFICOS -->
    <div class="row text-center mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Status</h6>
                    <canvas id="graficoStatus" width="180" height="180"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Origem</h6>
                    <canvas id="graficoOrigem" width="180" height="180"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Valor por Status</h6>
                    <canvas id="graficoValor" width="180" height="180"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- TABELA -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Origem</th>
                        <th>Cliente</th>
                        <th>Data</th>
                        <th>Valor</th>
                        <th>Status</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pedido in pedidos)
                    {
                        var badge = pedido.Status switch
                        {
                            "Pago" => "success",
                            "Enviado" => "primary",
                            "Aguardando envio" => "warning",
                            "Cancelado" => "danger",
                            _ => "secondary"
                        };

                        <tr>
                            <td>@pedido.Id</td>
                            <td>@pedido.Origem</td>
                            <td>@pedido.Cliente</td>
                            <td>@pedido.Data.ToString("dd/MM/yyyy")</td>
                            <td>@pedido.ValorTotal.ToString("C")</td>
                            <td>
                                <span class="badge bg-@badge">@pedido.Status</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Detalhes" asp-route-id="@pedido.Id" class="btn btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="AtualizarStatus" asp-route-id="@pedido.Id" class="btn btn-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ImprimirEtiqueta" asp-route-id="@pedido.Id" class="btn btn-success">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- CHART.JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pedidos.GroupBy(p => p.Status).Select(g => g.Key)));
    const statusValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pedidos.GroupBy(p => p.Status).Select(g => g.Count())))

    const origemLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pedidos.GroupBy(p => p.Origem).Select(g => g.Key)));
    const origemValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pedidos.GroupBy(p => p.Origem).Select(g => g.Count())));

    const valorStatus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                pedidos.GroupBy(p => p.Status).Select(g => g.Sum(x => x.ValorTotal))
                ));

    new Chart(graficoStatus, {
        type: 'pie',
        data: { labels: statusLabels, datasets: [{ data: statusValues }] },
        options: { responsive: false }
    });

    new Chart(graficoOrigem, {
        type: 'doughnut',
        data: { labels: origemLabels, datasets: [{ data: origemValues }] },
        options: { responsive: false }
    });

    new Chart(graficoValor, {
        type: 'bar',
        data: {
            labels: statusLabels,
            datasets: [{ label: 'Valor Total', data: valorStatus }]
        },
        options: { responsive: false }
    });
</script>
