@model WebFamily.Models.PedidoDto

@{
    ViewData["Title"] = "Atualizar Status do Pedido";
}

<h2 class="mb-4">Atualizar Status</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Pedido:</strong> @Model.Id</p>
        <p><strong>Cliente:</strong> @Model.Cliente</p>
        <p><strong>Origem:</strong> @Model.Origem</p>

        <form asp-action="AtualizarStatus" method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select" required>
                    <option value="Pago" selected="@(@Model.Status == "Pago")">Pago</option>
                    <option value="Enviado" selected="@(@Model.Status == "Enviado")">Enviado</option>
                    <option value="Aguardando envio" selected="@(@Model.Status == "Aguardando envio")">Aguardando envio</option>
                    <option value="Cancelado" selected="@(@Model.Status == "Cancelado")">Cancelado</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success">Salvar</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </form>
    </div>
</div>
