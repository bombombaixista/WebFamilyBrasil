@model WebFamily.Models.PedidoDto

@{
    ViewData["Title"] = "Etiqueta de Envio";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Etiqueta</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap (se já estiver no layout principal, aqui não interfere) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 15px;
            background: #f8f9fa;
        }

        .etiqueta {
            max-width: 420px;
            margin: auto;
            background: #fff;
            border: 2px dashed #000;
            padding: 20px;
        }

        h2 {
            text-align: center;
            margin-bottom: 15px;
            font-size: 1.25rem;
        }

        .linha {
            margin-bottom: 6px;
            font-size: 0.95rem;
        }

        .titulo {
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="etiqueta">
        <h2>📦 ETIQUETA DE ENVIO</h2>

        <div class="linha">
            <span class="titulo">Pedido:</span> @Model.Id
        </div>

        <div class="linha">
            <span class="titulo">Cliente:</span> @Model.Cliente
        </div>

        <div class="linha">
            <span class="titulo">Endereço:</span><br />
            @Model.Endereco<br />
            @Model.Cidade - @Model.Estado<br />
            CEP: @Model.CEP
        </div>

        <div class="linha">
            <span class="titulo">Transportadora:</span> @Model.Transportadora
        </div>

        <div class="linha">
            <span class="titulo">Rastreamento:</span> @Model.CodigoRastreamento
        </div>

        <hr />

        <div class="linha">
            <span class="titulo">Origem:</span> @Model.Origem
        </div>

        <div class="linha">
            <span class="titulo">Data:</span> @Model.Data.ToString("dd/MM/yyyy")
        </div>
    </div>

    <!-- BOTÕES RESPONSIVOS -->
    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center mt-3">
        <button onclick="window.print()" class="btn btn-primary btn-sm">
            🖨 Imprimir
        </button>

        <a asp-controller="Pedidos" asp-action="Index" class="btn btn-secondary btn-sm">
            Voltar
        </a>
    </div>

</body>
</html>
