@model IEnumerable<Cliente2>

<h2>Lista de Clientes</h2>

<p>
    <a asp-action="Cadastrar" class="btn btn-success">Novo Cliente</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Email</th>
            <th>Plano</th>
            <th>Data Cadastro</th>
            <th>Ativo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>@cliente.Nome</td>
                <td>@cliente.Email</td>
                <td>@cliente.Plano?.Nome</td>
                <td>@cliente.DataCadastro.ToString("dd/MM/yyyy")</td>
                <td>@(cliente.Ativo ? "Sim" : "Não")</td>
            </tr>
        }
    </tbody>
</table>
