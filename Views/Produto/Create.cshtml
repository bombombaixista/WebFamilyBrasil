@model Kanban.Models.Produto

<h2>Criar Produto</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Nome</label>
        <input asp-for="Nome" class="form-control" />
    </div>

    <div class="form-group">
        <label>Preço</label>
        <input asp-for="Preco" class="form-control" />
    </div>

    <div class="form-group">
        <label>Estoque</label>
        <input asp-for="Estoque" class="form-control" />
    </div>

    <div class="form-group">
        <label>Categoria</label>
        <input asp-for="Categoria" class="form-control" />
    </div>

    <div class="form-group">
        <label>Descrição</label>
        <textarea asp-for="Descricao" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Condição</label>
        <select asp-for="Condicao" class="form-control">
            <option value="new">Novo</option>
            <option value="used">Usado</option>
        </select>
    </div>

    <div class="form-group">
        <label>URL da Imagem</label>
        <input asp-for="ImagemUrl" class="form-control" />
    </div>

    <!-- Checkbox para publicar no ML -->
    <div class="form-check">
        <input type="checkbox" name="PublicarNoMercadoLivre" class="form-check-input" />
        <label class="form-check-label">Publicar também no Mercado Livre</label>
    </div>

    <button type="submit" class="btn btn-success mt-3">Salvar</button>
</form>
