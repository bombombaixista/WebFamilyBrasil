@model IEnumerable<Kanban.Models.Produto>

<h2>Meus Produtos</h2>

<!-- Botões de ação -->
<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">+ Novo Produto</a>
    <a asp-controller="MercadoLivre" asp-action="Produtos" asp-route-clienteId="062a57ff-e2e5-46e3-9e8e-f1c650b1d05c"
       class="btn btn-primary">Sincronizar com Mercado Livre</a>
</div>

<!-- Abas para alternar gráficos -->
<ul class="nav nav-tabs mb-3" id="graficoTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="pizza-tab" data-bs-toggle="tab" data-bs-target="#pizza" type="button" role="tab">Estoque</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="donut-tab" data-bs-toggle="tab" data-bs-target="#donut" type="button" role="tab">Preço Total</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="barra-tab" data-bs-toggle="tab" data-bs-target="#barra" type="button" role="tab">Comparativo Estoque</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="linha-tab" data-bs-toggle="tab" data-bs-target="#linha" type="button" role="tab">Evolução Estoque</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="radar-tab" data-bs-toggle="tab" data-bs-target="#radar" type="button" role="tab">Radar Estoque x Preço</button>
    </li>
</ul>

<!-- Conteúdo das abas -->
<div class="tab-content text-center mb-4" id="graficoTabsContent">
    <div class="tab-pane fade show active" id="pizza" role="tabpanel">
        <div style="width:180px;height:180px;margin:auto">
            <canvas id="graficoPizza"></canvas>
        </div>
    </div>
    <div class="tab-pane fade" id="donut" role="tabpanel">
        <div style="width:180px;height:180px;margin:auto">
            <canvas id="graficoDonut"></canvas>
        </div>
    </div>
    <div class="tab-pane fade" id="barra" role="tabpanel">
        <div style="width:180px;height:180px;margin:auto">
            <canvas id="graficoBarra"></canvas>
        </div>
    </div>
    <div class="tab-pane fade" id="linha" role="tabpanel">
        <div style="width:180px;height:180px;margin:auto">
            <canvas id="graficoLinha"></canvas>
        </div>
    </div>
    <div class="tab-pane fade" id="radar" role="tabpanel">
        <div style="width:180px;height:180px;margin:auto">
            <canvas id="graficoRadar"></canvas>
        </div>
    </div>
</div>

<!-- Campo de filtro -->
<input type="text" id="filtro" class="form-control mb-3" placeholder="Filtrar por nome ou categoria..." />

<!-- Tabela de produtos -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Categoria</th>
            <th>Estoque</th>
            <th>Preço</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Categoria</td>
                <td>@item.Estoque</td>
                <td>@item.Preco</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Scripts no final -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Filtro de tabela
    document.getElementById("filtro").addEventListener("keyup", function () {
        var filtro = this.value.toLowerCase();
        var linhas = document.querySelectorAll("tbody tr");
        linhas.forEach(function (linha) {
            var texto = linha.textContent.toLowerCase();
            linha.style.display = texto.includes(filtro) ? "" : "none";
        });
    });

    // Agrupamento por categoria
    var produtos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
    var categorias = {};
    produtos.forEach(p => {
        if (!categorias[p.Categoria]) {
            categorias[p.Categoria] = { estoque: 0, preco: 0 };
        }
        categorias[p.Categoria].estoque += p.Estoque;
        categorias[p.Categoria].preco += p.Preco;
    });

    var labels = Object.keys(categorias);
    var estoques = labels.map(c => categorias[c].estoque);
    var precos = labels.map(c => categorias[c].preco);

    const optionsBase = { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } };

    // Gráficos
    new Chart(document.getElementById("graficoPizza"), { type: "pie", data: { labels, datasets: [{ data: estoques, backgroundColor: ["#FF6384","#36A2EB","#FFCE56","#4CAF50","#9C27B0"] }] }, options: optionsBase });
    new Chart(document.getElementById("graficoDonut"), { type: "doughnut", data: { labels, datasets: [{ data: precos, backgroundColor: ["#FF6384","#36A2EB","#FFCE56","#4CAF50","#9C27B0"] }] }, options: optionsBase });
    new Chart(document.getElementById("graficoBarra"), { type: "bar", data: { labels, datasets: [{ label: "Estoque", data: estoques, backgroundColor: "#36A2EB" }] }, options: { ...optionsBase, scales: { y: { beginAtZero: true } } } });
    new Chart(document.getElementById("graficoLinha"), { type: "line", data: { labels: produtos.map(p => p.Nome), datasets: [{ label: "Estoque", data: produtos.map(p => p.Estoque), borderColor: "#FF6384", backgroundColor: "rgba(255,99,132,0.2)", fill: true, tension: 0.3 }] }, options: optionsBase });
    new Chart(document.getElementById("graficoRadar"), { type: "radar", data: { labels, datasets: [{ label: "Estoque", data: estoques, borderColor: "#36A2EB", backgroundColor: "rgba(54,162,235,0.2)" }, { label: "Preço", data: precos, borderColor: "#FF6384", backgroundColor: "rgba(255,99,132,0.2)" }] }, options: optionsBase });
</script>
