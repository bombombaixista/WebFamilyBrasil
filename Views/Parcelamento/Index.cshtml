@model Kanban.Models.ParcelamentoResultado

<h2>Calculadora de Parcelamento no Cartão</h2>

<form asp-action="Index" method="post">
    <label>Categoria:</label>
    <input type="text" name="categoria" />

    <label>Preço de Venda:</label>
    <input type="number" step="0.01" name="precoVenda" />

    <label>Número de Parcelas:</label>
    <input type="number" name="numeroParcelas" />

    <label>Taxa do Cartão (%):</label>
    <input type="number" step="0.01" name="taxaCartaoPercentual" />

    <button type="submit">Calcular</button>
</form>

@if (Model != null)
{
    <h3>Resultado</h3>
    <table class="table">
        <tr><th>Categoria</th><td>@Model.Categoria</td></tr>
        <tr><th>Preço Venda</th><td>@Model.PrecoVenda</td></tr>
        <tr><th>Número de Parcelas</th><td>@Model.NumeroParcelas</td></tr>
        <tr><th>Taxa do Cartão</th><td>@Model.TaxaCartaoPercentual %</td></tr>
        <tr><th>Valor da Taxa</th><td>@Model.TaxaCartaoValor</td></tr>
        <tr><th>Valor Líquido Loja</th><td>@Model.ValorLiquidoLoja</td></tr>
        <tr><th>Valor Total Parcelado</th><td>@Model.ValorTotalParcelado</td></tr>
        <tr><th>Valor da Parcela</th><td>@Model.ValorParcela</td></tr>
        <tr><th>Alerta</th><td>@Model.Alerta</td></tr>
    </table>

    <h3>Gráficos</h3>
    <div style="display:flex; justify-content:center; gap:30px; margin-top:20px;">
        <div style="width:220px; height:220px; text-align:center; border:1px solid #ccc; border-radius:10px; padding:10px;">
            <h5>💳 Taxa vs Loja</h5>
            <canvas id="graficoPizza"></canvas>
        </div>
        <div style="width:220px; height:220px; text-align:center; border:1px solid #ccc; border-radius:10px; padding:10px;">
            <h5>📊 Parcelas</h5>
            <canvas id="graficoBarra"></canvas>
        </div>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

@if (Model != null)
{
    <script>
        // Dados para gráficos
        const dadosPizza = {
        labels: ['Taxa Cartão', 'Valor Líquido Loja'],
        datasets: [{
        data: [@Model.TaxaCartaoValor, @Model.ValorLiquidoLoja],
        backgroundColor: ['#e53935', '#43a047']
        }]
        };

        const dadosBarra = {
        labels: Array.from({length: @Model.NumeroParcelas}, (_, i) => (i+1) + "ª Parcela"),
        datasets: [{
        label: 'Valor da Parcela',
        data: Array(@Model.NumeroParcelas).fill(@Model.ValorParcela),
        backgroundColor: '#36a2eb'
        }]
        };

        new Chart(document.getElementById('graficoPizza'), {
        type: 'pie',
        data: dadosPizza,
        options: { responsive: true, maintainAspectRatio: false }
        });

        new Chart(document.getElementById('graficoBarra'), {
        type: 'bar',
        data: dadosBarra,
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true } }
        }
        });
    </script>
}
