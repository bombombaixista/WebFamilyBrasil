@model Kanban.Models.ConsignacaoResultado

<h2>Calculadora de Consignação</h2>

<form asp-action="Index" method="post">
    <label>Categoria:</label>
    <input type="text" name="categoria" />

    <label>Preço de Venda:</label>
    <input type="number" step="0.01" name="precoVenda" />

    <label>Custo Produto:</label>
    <input type="number" step="0.01" name="custoProduto" />

    <label>Frete:</label>
    <input type="number" step="0.01" name="frete" />

    <label>Taxa Percentual:</label>
    <input type="number" step="0.01" name="taxaPercentual" />

    <label>Margem da Loja (%):</label>
    <input type="number" step="0.01" name="margemLoja" />

    <label>Margem do Vendedor (%):</label>
    <input type="number" step="0.01" name="margemVendedor" />

    <label>Imposto (%):</label>
    <input type="number" step="0.01" name="impostoPercentual" />

    <button type="submit">Calcular</button>
</form>

@if (Model != null)
{
    <h3>Resultado</h3>
    <table class="table">
        <tr><th>Categoria</th><td>@Model.Categoria</td></tr>
        <tr><th>Preço Venda</th><td>@Model.PrecoVenda</td></tr>
        <tr><th>Comissão Loja</th><td>@Model.ComissaoLoja</td></tr>
        <tr><th>Lucro Loja</th><td>@Model.LucroLoja</td></tr>
        <tr><th>Valor Vendedor</th><td>@Model.ValorVendedor</td></tr>
        <tr><th>Margem Vendedor</th><td>@Model.MargemVendedor %</td></tr>
        <tr><th>Alerta</th><td>@Model.Alerta</td></tr>
    </table>

    <h3>Gráficos</h3>
    <div style="display:flex; justify-content:center; gap:30px; margin-top:20px;">
        <!-- Card Pizza -->
        <div style="width:200px; text-align:center; border:1px solid #ccc; border-radius:10px; padding:10px; box-shadow:2px 2px 6px rgba(0,0,0,0.1);">
            <h5 id="tituloPizza"></h5>
            <div style="width:180px; height:180px; margin:auto;">
                <canvas id="graficoPizza"></canvas>
            </div>
        </div>

        <!-- Card Donut -->
        <div style="width:200px; text-align:center; border:1px solid #ccc; border-radius:10px; padding:10px; box-shadow:2px 2px 6px rgba(0,0,0,0.1);">
            <h5 id="tituloDonut"></h5>
            <div style="width:180px; height:180px; margin:auto;">
                <canvas id="graficoDonut"></canvas>
            </div>
        </div>

        <!-- Card Barras -->
        <div style="width:200px; text-align:center; border:1px solid #ccc; border-radius:10px; padding:10px; box-shadow:2px 2px 6px rgba(0,0,0,0.1);">
            <h5 id="tituloBarra"></h5>
            <div style="width:180px; height:180px; margin:auto;">
                <canvas id="graficoBarra"></canvas>
            </div>
        </div>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

@if (Model != null)
{
<script>
    // 🔥 Definição de cores e ícones por categoria
    let coresCategoria;
    let iconeCategoria;
    switch ("@Model.Categoria".toLowerCase()) {
        case "guitarra":
            coresCategoria = ['#e53935', '#ff7043', '#d32f2f']; // tons de vermelho
            iconeCategoria = "🎸 Guitarra";
            break;
        case "baixo":
            coresCategoria = ['#1e88e5', '#42a5f5', '#1565c0']; // tons de azul
            iconeCategoria = "🎹 Baixo";
            break;
        case "pedal":
            coresCategoria = ['#43a047', '#66bb6a', '#2e7d32']; // tons de verde
            iconeCategoria = "🎛️ Pedal";
            break;
        case "acessório":
            coresCategoria = ['#fbc02d', '#fdd835', '#f57f17']; // tons de amarelo/laranja
            iconeCategoria = "🎶 Acessório";
            break;
        default:
            coresCategoria = ['#ff6384', '#36a2eb', '#4caf50']; // padrão
            iconeCategoria = "📦 Produto";
            break;
    }

    // Atualiza títulos dos cards com ícone da categoria
    document.getElementById("tituloPizza").innerText = iconeCategoria + " - Pizza";
    document.getElementById("tituloDonut").innerText = iconeCategoria + " - Donut";
    document.getElementById("tituloBarra").innerText = iconeCategoria + " - Barras";

    const dados = {
        labels: ['Comissão Loja', 'Lucro Loja', 'Valor Vendedor'],
        datasets: [{
            data: [@Model.ComissaoLoja, @Model.LucroLoja, @Model.ValorVendedor],
            backgroundColor: coresCategoria
        }]
    };

    // Pizza
    new Chart(document.getElementById('graficoPizza'), {
        type: 'pie',
        data: dados,
        options: { responsive: true, maintainAspectRatio: false }
    });

    // Donut
    new Chart(document.getElementById('graficoDonut'), {
        type: 'doughnut',
        data: dados,
        options: { responsive: true, maintainAspectRatio: false }
    });

    // Barras
    new Chart(document.getElementById('graficoBarra'), {
        type: 'bar',
        data: dados,
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true } }
        }
    });
</script>
}
