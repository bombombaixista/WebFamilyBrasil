@model IEnumerable<WebFamilyBrasil.Models.Insumo>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<div class="container mt-4">
    <h2 class="mb-3">Controle de Insumos</h2>

    <div class="mb-3">
        <a asp-action="Criar" class="btn btn-primary">+ Novo Insumo</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>Quantidade</th>
                    <th>Custo Unitário</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var insumo in Model)
                {
                    <tr>
                        <td>@insumo.Nome</td>
                        <td>@insumo.Tipo</td>
                        <td>@insumo.Quantidade</td>
                        <td>@insumo.CustoUnitario.ToString("C")</td>
                        <td>
                            <a asp-action="Editar" asp-route-id="@insumo.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Excluir" asp-route-id="@insumo.Id" class="btn btn-sm btn-danger">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="alert alert-warning">Nenhum insumo cadastrado ainda.</p>
    }
</div>
