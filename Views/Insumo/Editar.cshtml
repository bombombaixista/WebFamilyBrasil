@model WebFamilyBrasil.Models.Insumo

<h2>Editar Insumo</h2>

<form asp-action="Editar" method="post">
    <input type="hidden" asp-for="Id" />

    <div>
        <label>Nome</label>
        <input asp-for="Nome" />
    </div>
    <div>
        <label>Tipo</label>
        <input asp-for="Tipo" />
    </div>
    <div>
        <label>Quantidade</label>
        <input asp-for="Quantidade" type="number" />
    </div>
    <div>
        <label>Custo Unitário</label>
        <input asp-for="CustoUnitario" type="number" step="0.01" />
    </div>
    <button type="submit">Salvar Alterações</button>
</form>
