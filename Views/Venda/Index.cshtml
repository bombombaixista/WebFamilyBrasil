@{
    ViewData["Title"] = "Planos WebFamily";
}

<section class="planos py-5">
    <div class="container">
        <h2 class="text-center mb-5 fw-bold">Escolha o Plano do WebFamily</h2>
        <div class="row g-4 justify-content-center">

            <!-- PLANO C (Básico) -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100 plano-card">
                    <div class="card-header text-center bg-success text-white">
                        <h4>Básico</h4>
                    </div>
                    <div class="card-body text-center">
                        <form asp-controller="Venda" asp-action="EscolherPlano" method="post">
                            <input type="hidden" name="Nome" value="@User.Identity?.Name" />
                            <input type="hidden" name="Email" value="@User.Identity?.Name" />
                            <input type="hidden" name="Plano" value="C" /> <!-- Código do plano -->
                            <input type="hidden" name="Expiracao" value="@DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd")" />
                            <button type="submit" class="btn btn-success btn-lg">Escolher Básico</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- PLANO B (Profissional) -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100 plano-card">
                    <div class="card-header text-center bg-primary text-white">
                        <h4>Profissional</h4>
                    </div>
                    <div class="card-body text-center">
                        <form asp-controller="Venda" asp-action="EscolherPlano" method="post">
                            <input type="hidden" name="Nome" value="@User.Identity?.Name" />
                            <input type="hidden" name="Email" value="@User.Identity?.Name" />
                            <input type="hidden" name="Plano" value="B" />
                            <input type="hidden" name="Expiracao" value="@DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd")" />
                            <button type="submit" class="btn btn-primary btn-lg">Escolher Profissional</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- PLANO A (Empresarial) -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100 plano-card">
                    <div class="card-header text-center bg-warning text-dark">
                        <h4>Empresarial</h4>
                    </div>
                    <div class="card-body text-center">
                        <form asp-controller="Venda" asp-action="EscolherPlano" method="post">
                            <input type="hidden" name="Nome" value="@User.Identity?.Name" />
                            <input type="hidden" name="Email" value="@User.Identity?.Name" />
                            <input type="hidden" name="Plano" value="A" />
                            <input type="hidden" name="Expiracao" value="@DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd")" />
                            <button type="submit" class="btn btn-warning btn-lg">Escolher Empresarial</button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
