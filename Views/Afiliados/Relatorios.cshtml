@model List<dynamic>
@{
    ViewData["Title"] = "Relatórios";
}

<h3>Relatórios de Afiliados</h3>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Clique</th>
            <th>Conversão (%)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Nome</td>
                <td>@r.Cliques</td>
                <td>@r.Conversao</td>
            </tr>
        }
    </tbody>
</table>