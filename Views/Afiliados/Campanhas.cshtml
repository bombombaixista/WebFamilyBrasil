@model List<dynamic>
@{
    ViewData["Title"] = "Campanhas";
}

<h3>Campanhas Ativas / Finalizadas</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Status</th>
            <th>Vendas</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nome</td>
                <td>@c.Status</td>
                <td>@c.Vendas</td>
            </tr>
        }
    </tbody>
</table>