@model List<string>
@{
    ViewBag.Title = "Campanhas Promocionais";
}

<h2>Campanhas Promocionais</h2>

<!-- 🔹 Cards de métricas principais -->
<div class="d-flex justify-content-center gap-4 mb-4">
    <div class="card text-center bg-primary text-white" style="width:260px; height:140px;">
        <div class="card-body d-flex flex-column justify-content-center">
            <h6 class="card-title">Total de Campanhas</h6>
            <h3>@(Model?.Count ?? 0)</h3>
        </div>
    </div>

    <div class="card text-center bg-success text-white" style="width:260px; height:140px;">
        <div class="card-body d-flex flex-column justify-content-center">
            <h6 class="card-title">Campanhas Ativas</h6>
            <h3>@(ViewBag.CampanhasAtivas ?? 0)</h3>
        </div>
    </div>

    <div class="card text-center bg-warning text-dark" style="width:260px; height:140px;">
        <div class="card-body d-flex flex-column justify-content-center">
            <h6 class="card-title">Campanhas Encerradas</h6>
            <h3>@(ViewBag.CampanhasEncerradas ?? 0)</h3>
        </div>
    </div>
</div>

<!-- 🔹 Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <form class="row g-3">
            <div class="col-md-6">
                <label for="nomeCampanha" class="form-label">Nome da Campanha</label>
                <input type="text" id="nomeCampanha" class="form-control" placeholder="Buscar por nome..." />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            </div>
        </form>
    </div>
</div>

<!-- 🔹 Lista de campanhas -->
<ul class="list-group">
    @foreach (var campanha in Model ?? new List<string>())
    {
        <li class="list-group-item">@campanha</li>
    }
</ul>
