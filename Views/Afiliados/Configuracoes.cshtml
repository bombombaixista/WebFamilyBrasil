@model dynamic
@{
    ViewData["Title"] = "Configurações";
}

<h3>Configurações do Afiliado</h3>

<ul class="list-group">
    <li class="list-group-item"><strong>Notificações:</strong> @(Model.Notificacoes ? "Ativas" : "Desativadas")</li>
    <li class="list-group-item"><strong>Método de Pagamento:</strong> @Model.Pagamento</li>
    <li class="list-group-item"><strong>Tema:</strong> @Model.Tema</li>
</ul>