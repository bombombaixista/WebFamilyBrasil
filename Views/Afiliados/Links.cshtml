@model string
@{
    ViewBag.Title = "Gerador de Links de Afiliado";
}

<h2>Gerador de Links de Afiliado</h2>

<!-- 🔹 Cards de métricas principais -->
<div class="d-flex justify-content-center gap-4 mb-4">
    <div class="card text-center bg-primary text-white" style="width:260px; height:140px;">
        <div class="card-body d-flex flex-column justify-content-center">
            <h6 class="card-title">Links Gerados</h6>
            <h3>@(ViewBag.TotalLinks ?? 0)</h3>
        </div>
    </div>

    <div class="card text-center bg-success text-white" style="width:260px; height:140px;">
        <div class="card-body d-flex flex-column justify-content-center">
            <h6 class="card-title">Último Produto</h6>
            <h3>@(ViewBag.UltimoProduto ?? "—")</h3>
        </div>
    </div>

    <div class="card text-center bg-warning text-dark" style="width:260px; height:140px;">
        <div class="card-body d-flex flex-column justify-content-center">
            <h6 class="card-title">Data</h6>
            <h3>@DateTime.Now.ToShortDateString()</h3>
        </div>
    </div>
</div>

<!-- 🔹 Link gerado -->
<p>Seu link gerado:</p>
<div class="alert alert-info">
    @ViewBag.LinkGerado
</div>

<button class="btn btn-success" onclick="navigator.clipboard.writeText('@ViewBag.LinkGerado')">
    Copiar Link
</button>
