@model List<dynamic>
@{
    ViewData["Title"] = "Produtos";
}

<h3>Meus Produtos</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Link</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Title</td>
                <td><a href="@p.Link" target="_blank">Ver no Mercado Livre</a></td>
            </tr>
        }
    </tbody>
</table>