@model List<LogIntegracao>

<h2>Logs de Integração - Mercado Livre</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Data</th>
            <th>Tipo</th>
            <th>Evento</th>
            <th>Sucesso</th>
            <th>Erro</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.Data</td>
                <td>@log.Tipo</td>
                <td>@log.Evento</td>
                <td>
                    @if (log.Sucesso)
                    {
                        <span class="badge bg-success">Sim</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Não</span>
                    }
                </td>
                <td>@log.Erro</td>
            </tr>
        }
    </tbody>
</table>