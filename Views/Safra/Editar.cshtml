@model WebFamilyBrasil.Models.Safra

<h2>Editar Safra</h2>

<form asp-action="Editar" method="post">
    <input type="hidden" asp-for="Id" />

    <div>
        <label>Talhão</label>
        <input asp-for="Talhao" />
    </div>
    <div>
        <label>Cultura</label>
        <input asp-for="Cultura" />
    </div>
    <div>
        <label>Data de Plantio</label>
        <input asp-for="DataPlantio" type="date" />
    </div>
    <div>
        <label>Data de Colheita</label>
        <input asp-for="DataColheita" type="date" />
    </div>
    <div>
        <label>Custo Estimado</label>
        <input asp-for="CustoEstimado" type="number" step="0.01" />
    </div>
    <div>
        <label>Produção Esperada</label>
        <input asp-for="ProducaoEsperada" type="number" step="0.01" />
    </div>
    <button type="submit">Salvar Alterações</button>
</form>
