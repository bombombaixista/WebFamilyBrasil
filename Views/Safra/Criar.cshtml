@model WebFamilyBrasil.Models.Safra

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<div class="container mt-4">
    <h2 class="mb-3">Cadastrar Nova Safra</h2>

    <form asp-action="Criar" method="post" class="row g-3">
        <div class="col-md-6">
            <label asp-for="Talhao" class="form-label"></label>
            <input asp-for="Talhao" class="form-control" />
            <span asp-validation-for="Talhao" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Cultura" class="form-label"></label>
            <input asp-for="Cultura" class="form-control" />
            <span asp-validation-for="Cultura" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="DataPlantio" class="form-label"></label>
            <input asp-for="DataPlantio" type="date" class="form-control" />
            <span asp-validation-for="DataPlantio" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="DataColheita" class="form-label"></label>
            <input asp-for="DataColheita" type="date" class="form-control" />
            <span asp-validation-for="DataColheita" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="CustoEstimado" class="form-label"></label>
            <input asp-for="CustoEstimado" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="CustoEstimado" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="ProducaoEsperada" class="form-label"></label>
            <input asp-for="ProducaoEsperada" type="number" class="form-control" />
            <span asp-validation-for="ProducaoEsperada" class="text-danger"></span>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-success">Salvar</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
