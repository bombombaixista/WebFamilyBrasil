@model IEnumerable<Kanban.Models.Produto>

<div class="container mt-4">
    <h2 class="text-center mb-4 text-primary">🛒 Catálogo do E-commerce</h2>

    <div class="row">
        @foreach (var produto in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-lg border-0">
                    <div class="card-header bg-gradient bg-primary text-white">
                        <h5 class="mb-0">@produto.Nome</h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <p class="card-text">
                            <span class="fw-bold text-success">Preço:</span>
                            <span class="fs-5">@produto.Preco.ToString("C")</span>
                        </p>
                        <p class="card-text">
                            <span class="fw-bold text-secondary">Estoque:</span>
                            <span class="badge bg-warning text-dark">@produto.Estoque</span>
                        </p>

                        <form asp-controller="Ecommerce" asp-action="Comprar" method="post" class="mt-auto">
                            <input type="hidden" name="produtoId" value="@produto.Id" />
                            <div class="mb-2">
                                <label class="form-label text-muted">Quantidade</label>
                                <input type="number" class="form-control border-primary" name="quantidade" value="1" min="1" max="@produto.Estoque" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label text-muted">Cliente</label>
                                <input type="text" class="form-control border-success" name="cliente" placeholder="Nome do cliente" />
                            </div>
                            <button type="submit" class="btn btn-success w-100 fw-bold">
                                Comprar agora 🚀
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
