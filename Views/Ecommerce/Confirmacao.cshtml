@{
    ViewData["Title"] = "Confirmação de compra";
    Layout = "_Layout";
}

<div class="container mt-5">
    <!-- Cards no topo -->
    <div class="d-flex justify-content-center gap-4 mb-4">
        <div class="card text-center bg-success text-white" style="width:220px; height:120px;">
            <div class="card-body d-flex flex-column justify-content-center">
                <h6 class="card-title">Status</h6>
                <h3>Sucesso ✓</h3>
            </div>
        </div>
        <div class="card text-center bg-primary text-white" style="width:220px; height:120px;">
            <div class="card-body d-flex flex-column justify-content-center">
                <h6 class="card-title">Pedido</h6>
                <h3>#12345</h3> <!-- aqui você pode renderizar o ID real -->
            </div>
        </div>
        <div class="card text-center bg-warning text-dark" style="width:220px; height:120px;">
            <div class="card-body d-flex flex-column justify-content-center">
                <h6 class="card-title">Data</h6>
                <h3>@DateTime.Now.ToString("dd/MM/yyyy")</h3>
            </div>
        </div>
    </div>

    <!-- Mensagem de confirmação -->
    <div class="card shadow-sm border-0 mx-auto" style="max-width:720px;">
        <div class="card-body text-center">
            <div class="mb-3">
                <i class="bi bi-check-circle-fill text-success" style="font-size:48px;"></i>
            </div>
            <h2 class="fw-bold text-success">Compra realizada com sucesso</h2>
            <p class="text-muted fs-5">Seu pedido foi confirmado. Obrigado pela compra!</p>

            <a href="/Ecommerce/Index" class="btn btn-primary btn-lg mt-3 fw-bold">
                Voltar ao catálogo
            </a>
        </div>
    </div>

    <!-- Gráfico pequeno -->
    <div class="card shadow-sm border-0 mt-4 mx-auto" style="max-width:480px;">
        <div class="card-body text-center">
            <h6>Status dos pedidos</h6>
            <canvas id="graficoStatus" style="max-height:250px;"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctxStatus = document.getElementById('graficoStatus').getContext('2d');
        new Chart(ctxStatus, {
            type: 'pie',
            data: {
                labels: ['Sucesso', 'Cancelado', 'Pendente'],
                datasets: [{
                    data: [80, 10, 10], // valores de exemplo, você pode renderizar do banco
                    backgroundColor: ['#28a745', '#dc3545', '#ffc107']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    </script>
}
