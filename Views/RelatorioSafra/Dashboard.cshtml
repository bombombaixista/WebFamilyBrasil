@model Tuple<IEnumerable<WebFamilyBrasil.Models.RelatorioSafra>, IEnumerable<WebFamilyBrasil.Models.Insumo>>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container mt-4">
    <h2 class="mb-3">Dashboard Agro</h2>

    <!-- Cards de Resumo -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center bg-light">
                <div class="card-body">
                    <h6 class="card-title">Custos Estimados</h6>
                    <p class="card-text fw-bold">
                        @Model.Item1.Sum(s => s.CustoEstimado).ToString("C")
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center bg-light">
                <div class="card-body">
                    <h6 class="card-title">Custos Insumos</h6>
                    <p class="card-text fw-bold">
                        @Model.Item1.Sum(s => s.CustoInsumos).ToString("C")
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center bg-light">
                <div class="card-body">
                    <h6 class="card-title">Custos Totais</h6>
                    <p class="card-text fw-bold">
                        @Model.Item1.Sum(s => s.CustoTotal).ToString("C")
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center bg-light">
                <div class="card-body">
                    <h6 class="card-title">Lucro Estimado</h6>
                    <p class="card-text fw-bold">
                        @(Model.Item1.Sum(s => s.LucroEstimado ?? 0).ToString("C"))
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos -->
    <div class="row">
        <div class="col-md-6">
            <h4>Safras</h4>
            <div class="d-flex gap-3 flex-wrap">
                <div style="width:200px; height:200px;">
                    <canvas id="graficoSafraPizza"></canvas>
                </div>
                <div style="width:200px; height:200px;">
                    <canvas id="graficoSafraDonut"></canvas>
                </div>
                <div style="width:200px; height:200px;">
                    <canvas id="graficoSafraBarra"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <h4>Insumos</h4>
            <div class="d-flex gap-3 flex-wrap">
                <div style="width:200px; height:200px;">
                    <canvas id="graficoInsumoBarra"></canvas>
                </div>
                <div style="width:200px; height:200px;">
                    <canvas id="graficoInsumoPizza"></canvas>
                </div>
                <div style="width:200px; height:200px;">
                    <canvas id="graficoInsumoLinha"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Dados dinâmicos de Safras
    var culturas = [];
    var custosTotais = [];
    var lucros = [];
    var custosEstimados = [];
    var custosInsumos = [];

    @foreach (var rel in Model.Item1)
    {
        <text>
            culturas.push("@rel.Cultura");
            custosTotais.push(@rel.CustoTotal);
            lucros.push(@(rel.LucroEstimado.HasValue ? rel.LucroEstimado.Value : 0));
            custosEstimados.push(@rel.CustoEstimado);
            custosInsumos.push(@rel.CustoInsumos);
        </text>
    }

    // Dados dinâmicos de Insumos
    var tipos = [];
    var quantidades = [];
    var custos = [];

    @foreach (var insumo in Model.Item2)
    {
        <text>
            tipos.push("@insumo.Tipo");
            quantidades.push(@insumo.Quantidade);
            custos.push(@insumo.CustoUnitario * @insumo.Quantidade);
        </text>
    }

    // Gráficos Safras
    new Chart(document.getElementById('graficoSafraPizza'), {
    type: 'pie',
    data: {
    labels: ['Custos Estimados', 'Custos Insumos'],
    datasets: [{
    data: [custosEstimados.reduce((a,b)=>a+b,0), custosInsumos.reduce((a,b)=>a+b,0)],
    backgroundColor: ['#ff6384', '#36a2eb']
    }]
    }
    });

    new Chart(document.getElementById('graficoSafraDonut'), {
    type: 'doughnut',
    data: {
    labels: ['Custos Totais', 'Lucro Estimado'],
    datasets: [{
    data: [custosTotais.reduce((a,b)=>a+b,0), lucros.reduce((a,b)=>a+b,0)],
    backgroundColor: ['#ffcd56', '#4bc0c0']
    }]
    }
    });

    new Chart(document.getElementById('graficoSafraBarra'), {
    type: 'bar',
    data: {
    labels: culturas,
    datasets: [{
    label: 'Lucro Estimado',
    data: lucros,
    backgroundColor: '#9966ff'
    }]
    },
    options: { scales: { y: { beginAtZero: true } } }
    });

    // Gráficos Insumos
    new Chart(document.getElementById('graficoInsumoBarra'), {
    type: 'bar',
    data: {
    labels: tipos,
    datasets: [{
    label: 'Quantidade',
    data: quantidades,
    backgroundColor: '#36a2eb'
    }]
    },
    options: { scales: { y: { beginAtZero: true } } }
    });

    new Chart(document.getElementById('graficoInsumoPizza'), {
    type: 'pie',
    data: {
    labels: tipos,
    datasets: [{
    data: custos,
    backgroundColor: ['#ff6384', '#ffcd56', '#4bc0c0', '#9966ff']
    }]
    }
    });

    new Chart(document.getElementById('graficoInsumoLinha'), {
    type: 'line',
    data: {
    labels: tipos,
    datasets: [{
    label: 'Estoque',
    data: quantidades,
    borderColor: '#2ecc71',
    fill: false
    }]
    },
    options: { scales: { y: { beginAtZero: true } } }
    });
</script>
