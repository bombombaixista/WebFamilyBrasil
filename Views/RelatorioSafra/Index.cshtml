@model IEnumerable<WebFamilyBrasil.Models.RelatorioSafra>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container mt-4">
    <h2 class="mb-3">Relatório de Custos e Lucro por Safra</h2>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Talhão</th>
                    <th>Cultura</th>
                    <th>Custo Estimado</th>
                    <th>Custo Insumos</th>
                    <th>Custo Total</th>
                    <th>Produção Esperada</th>
                    <th>Preço Mercado</th>
                    <th>Lucro Estimado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rel in Model)
                {
                    <tr>
                        <td>@rel.Talhao</td>
                        <td>@rel.Cultura</td>
                        <td>@rel.CustoEstimado.ToString("C")</td>
                        <td>@rel.CustoInsumos.ToString("C")</td>
                        <td>@rel.CustoTotal.ToString("C")</td>
                        <td>@rel.ProducaoEsperada</td>
                        <td>@rel.PrecoMercado.ToString("C")</td>
                        <td>@(rel.LucroEstimado.HasValue ? rel.LucroEstimado.Value.ToString("C") : "N/A")</td>
                    </tr>
                }
            </tbody>
        </table>

        <hr class="my-4" />

        <h4>Visualização Gráfica</h4>
        <div class="d-flex gap-3">
            <div style="width:200px; height:200px;">
                <canvas id="graficoPizza"></canvas>
            </div>
            <div style="width:200px; height:200px;">
                <canvas id="graficoDonut"></canvas>
            </div>
            <div style="width:200px; height:200px;">
                <canvas id="graficoBarra"></canvas>
            </div>
        </div>
    }
    else
    {
        <p class="alert alert-warning">Nenhuma safra cadastrada ainda. Cadastre uma safra e insumos para visualizar o relatório.</p>
    }
</div>

<script>
    // Preparar dados vindos do Model
    var culturas = [];
    var custosTotais = [];
    var lucros = [];
    var custosEstimados = [];
    var custosInsumos = [];

    @foreach (var rel in Model)
    {
        <text>
            culturas.push("@rel.Cultura");
            custosTotais.push(@rel.CustoTotal);
            lucros.push(@(rel.LucroEstimado.HasValue ? rel.LucroEstimado.Value : 0));
            custosEstimados.push(@rel.CustoEstimado);
            custosInsumos.push(@rel.CustoInsumos);
        </text>
    }

    // Gráfico Pizza - proporção de custos (estimado vs insumos)
    new Chart(document.getElementById('graficoPizza'), {
    type: 'pie',
    data: {
    labels: ['Custos Estimados', 'Custos Insumos'],
    datasets: [{
    data: [custosEstimados.reduce((a,b)=>a+b,0), custosInsumos.reduce((a,b)=>a+b,0)],
    backgroundColor: ['#ff6384', '#36a2eb']
    }]
    }
    });

    // Gráfico Donut - custos totais vs lucro
    new Chart(document.getElementById('graficoDonut'), {
    type: 'doughnut',
    data: {
    labels: ['Custos Totais', 'Lucro Estimado'],
    datasets: [{
    data: [custosTotais.reduce((a,b)=>a+b,0), lucros.reduce((a,b)=>a+b,0)],
    backgroundColor: ['#ffcd56', '#4bc0c0']
    }]
    }
    });

    // Gráfico Barra - lucro por safra
    new Chart(document.getElementById('graficoBarra'), {
    type: 'bar',
    data: {
    labels: culturas,
    datasets: [{
    label: 'Lucro Estimado',
    data: lucros,
    backgroundColor: '#9966ff'
    }]
    },
    options: {
    plugins: { legend: { display: false } },
    scales: { y: { beginAtZero: true } }
    }
    });
</script>
