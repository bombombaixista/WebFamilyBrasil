@model Kanban.Models.Financeiro

@{
    ViewData["Title"] = "Nova Transação";
}

<h1>Nova Transação</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Tipo</label>
        <select asp-for="Tipo" class="form-select" required>
            <option value="">Selecione</option>
            <option value="Receita">Receita</option>
            <option value="Despesa">Despesa</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Categoria (DRE)</label>
        <select asp-for="Categoria" class="form-select" required>
            <option value="">Selecione</option>
            <option value="Vendas">Vendas</option>
            <option value="Deducoes">Deduções</option>
            <option value="CMV">CMV</option>
            <option value="DespesasVendas">Despesas com Vendas</option>
            <option value="DespesasAdm">Despesas Administrativas</option>
            <option value="DespesasFinanceiras">Despesas Financeiras</option>
            <option value="ReceitasFinanceiras">Receitas Financeiras</option>
            <option value="OutrasReceitas">Outras Receitas</option>
            <option value="OutrasDespesas">Outras Despesas</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Descrição</label>
        <input asp-for="Descricao" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Valor</label>
        <input asp-for="Valor" type="number" step="0.01" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Data</label>
        <input asp-for="Data" type="date" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success">Salvar</button>
    <a class="btn btn-secondary" href="/Financeiro/RelatorioDRE">Cancelar</a>
</form>
