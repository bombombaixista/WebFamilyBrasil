<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Organizador de Tarefas</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <!-- Estilos extras das Views -->
    @RenderSection("Styles", required: false)
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">

            <!-- Logo -->
            <a class="navbar-brand" href="/">WebFamilyBrasil</a>

            <!-- Botão mobile -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">

                <ul class="navbar-nav me-auto">

                    <!-- Vendas -->
                    <li class="nav-item">
                        <a class="nav-link" href="/Pipeline">Vendas</a>
                    </li>

                    <!-- Tarefas -->
                    <li class="nav-item">
                        <a class="nav-link" href="/Tarefas">Tarefas</a>
                    </li>

                    <!-- E-commerce -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           data-bs-toggle="dropdown">
                            <i class="bi bi-cart3"></i> E-commerce
                        </a>

                        <ul class="dropdown-menu">

                            <li>@Html.ActionLink("Produtos", "Index", "Produto", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Pedidos", "Index", "Pedidos", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Loja Online", "Index", "Ecommerce", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Fornecedores", "Index", "Fornecedor", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("MercadoLivre", "Index", "IntegracaoMercadoLivre", null, new { @class = "dropdown-item" })</li>

                        </ul>

                    </li>


                    <!-- Dashboard -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           data-bs-toggle="dropdown">

                            <i class="bi bi-bar-chart-line"></i> Dashboard & Financeiro

                        </a>

                        <ul class="dropdown-menu">

                            <li>@Html.ActionLink("Financeiro", "Index", "Financeiro", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Dashboard", "Index", "Dashboard", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Relatorio Dre", "RelatorioDre", "Financeiro", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Bolsa de Valores", "Monitor", "Bolsa", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Calculadora", "Index", "Calculadora", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Consignacao", "Index", "Consignacao", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Parcelamento", "Index", "Parcelamento", null, new { @class = "dropdown-item" })</li>

                        </ul>

                    </li>


                    <!-- Afiliados -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           data-bs-toggle="dropdown">

                            <i class="bi bi-link-45deg"></i> Afiliados

                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                @Html.ActionLink(
                                "Central de Links",
                                                                "Links",
                                                                "Afiliados",
                                                                null,
                                                                new { @class = "dropdown-item" })
                            </li>

                        </ul>

                    </li>


                    <!-- Gestão -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           data-bs-toggle="dropdown">

                            <i class="bi bi-people"></i> Gestão

                        </a>

                        <ul class="dropdown-menu">

                            <li>@Html.ActionLink("Agenda", "Index", "Agenda", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Documento", "Index", "Documento", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Cadastro", "Index", "Clientes", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Funcionários", "Index", "Funcionario", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("RH", "Index", "RH", null, new { @class = "dropdown-item" })</li>

                        </ul>

                    </li>


                    <!-- Sistema -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           data-bs-toggle="dropdown">

                            <i class="bi bi-gear"></i> Sistema

                        </a>

                        <ul class="dropdown-menu">

                            <li>@Html.ActionLink("Backup", "Index", "Backup", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Checkout", "Index", "Checkout", null, new { @class = "dropdown-item" })</li>

                        </ul>

                    </li>


                    <!-- Logout -->
                    <li class="nav-item">
                        <a class="nav-link" href="/Login/Logout">
                            Logout
                        </a>
                    </li>

                </ul>

            </div>

        </div>
    </nav>


    <!-- CONTEÚDO -->
    <div class="container mt-4">

        @RenderBody()

    </div>


    <!-- Scripts específicos das views -->
    @RenderSection("Scripts", required: false)


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>