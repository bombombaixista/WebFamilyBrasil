@model List<Kanban.DTOs.EstatisticaProdutoDto>

@{
    ViewData["Title"] = "Estatísticas por Produto";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Produto</th>
            <th>Preço</th>
            <th>Cliques</th>
            <th>Conversões</th>
            <th>Receita Gerada</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Preco.ToString("C")</td>
                <td>@item.Cliques</td>
                <td>@item.Conversoes</td>
                <td>@item.ReceitaGerada.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>
